APP_NAME=NT Drone Competition Portal
APP_ENV=development
DEBUG=false
BASE_URL=http://localhost:8000
TIMEZONE=Asia/Bangkok

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-at-least-48-random-characters
COOKIE_SECURE=false

POSTGRES_PASSWORD=ntdrone-dev-password
DATABASE_URL=sqlite:///./data/ntdrone.db
STORAGE_ROOT=./data
MAX_UPLOAD_BYTES=10485760

ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe-NTDrone-2026!
ADMIN_EMAIL=admin@example.local

SLOT_DEFAULT_DURATION_MINUTES=180
BOOKING_COOLDOWN_SECONDS=300
WORKER_POLL_SECONDS=15

# SMTP is the primary notification channel. Empty host writes to the development log sink.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=NT Drone <noreply@example.local>
SMTP_STARTTLS=true

# SMS is optional and must not block the main workflow.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# mock is safe for development. wireguard executes app/wireguard/*.sh.
VPN_DRIVER=mock
VPN_CLIENT_NETWORK=10.248.0.0/24
WIREGUARD_INTERFACE=wg-ntdrone
WIREGUARD_SERVER_ENDPOINT=vpn.example.local:51820
WIREGUARD_SERVER_PUBLIC_KEY=REPLACE_WITH_SERVER_PUBLIC_KEY
WIREGUARD_DNS=1.1.1.1
VPN_ENABLE_SCRIPT=./app/wireguard/enable_peer.sh
VPN_DISABLE_SCRIPT=./app/wireguard/disable_peer.sh

# mock completes a run automatically. http sends commands to a remote simulator API.
SIMULATION_DRIVER=mock
SIMULATOR_API_URL=
SIMULATOR_API_TOKEN=replace-with-simulator-bearer-token
MOCK_SIMULATION_DURATION_SECONDS=20
